# Critical: never let a local .env (secrets) or local dev data (which may
# include repos/config not meant for the public showcase image, and any
# already-embedded local sandbox state) leak into the build context.
.env
.env.*
!.env.example
data/

# Live Cloudflare tunnel credentials. Gitignored, so `COPY . .` would
# otherwise bake them into an image layer without them ever showing up in
# `git status` - the reason this was easy to miss.
cloudflared/

.venv/
venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.git/
.gitignore
ROADMAP.md
