# GitHub user whose public repos should be synced.
GITHUB_USER=octocat

# A GitHub personal access token. Not required: git clone/pull and the REST
# API both work unauthenticated for public data. Only worth setting if
# repos.txt is empty (so `sync` falls back to listing every repo via REST) -
# a token raises that REST rate limit from 60/hr to 5000/hr. A classic PAT
# with no scopes selected is sufficient - create one at
# https://github.com/settings/tokens.
GITHUB_TOKEN=

# Where cloned repos are stored. Defaults to ./data if unset.
# DATA_DIR=./data

# Which file lists the repos to sync. Defaults to ./repos.txt if unset.
# REPOS_FILE=./repos.txt

# Local sentence-transformers-compatible embedding model. Defaults to
# Qwen/Qwen3-Embedding-0.6B if unset. Larger Qwen3-Embedding variants
# (4B/8B) improve retrieval quality if you have a GPU.
# EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# Which LLM provider `repo-sage ask` uses to synthesize answers: "ollama"
# (local, free, private, default) or "anthropic" (hosted, needs
# ANTHROPIC_API_KEY, faster/higher quality). Both speak the same
# tool-calling interface, so the rest of the app doesn't care which is
# active - switch anytime.
# LLM_PROVIDER=ollama

# Model used when LLM_PROVIDER=ollama, served locally via Ollama
# (https://ollama.com). Defaults to qwen3:8b if unset - pull it first
# with `ollama pull qwen3:8b`.
# OLLAMA_MODEL=qwen3:8b

# Where the local Ollama server is listening. Defaults to
# http://localhost:11434 if unset.
# OLLAMA_BASE_URL=http://localhost:11434

# Required when LLM_PROVIDER=anthropic. Create one at
# https://console.anthropic.com/settings/keys.
# ANTHROPIC_API_KEY=

# Model used when LLM_PROVIDER=anthropic. Defaults to
# claude-haiku-4-5-20251001 if unset - a deliberately cheap/fast default,
# since every call here is billed; use a larger model for higher quality.
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Caps the LLM's response length (both providers) - a cost/runaway-
# generation guard, since ask makes up to a few LLM calls per question.
# Defaults to 1024 if unset.
# LLM_MAX_TOKENS=1024

# --- reposage/web/ (the demo website) only - the CLI never reads these ---

# Shared passphrase gating the two routes that cost money or do real work -
# POST /api/ask and POST /api/sandbox/submit - sent as the X-Access-Code
# header. The read-only routes (/api/config, /api/repos,
# /api/sandbox/status) stay open deliberately: the page has to render
# before a visitor can enter a code, and the container healthcheck polls
# /api/config. They disclose nothing beyond the names of already-public
# repos. Empty (default) means even the gated routes are open.
# Recommended set for a real public deployment - see README "Deploying the
# demo website".
# WEB_ACCESS_CODE=

# Request budget: two independent tiers, hourly (burst protection) and
# daily (total spend protection). Either can be disabled by setting it to
# 0. Defaults: 10/hour, 30/day.
# WEB_HOURLY_REQUEST_LIMIT=10
# WEB_DAILY_REQUEST_LIMIT=30

# --- Nightly re-index (scripts/nightly-seed.sh) ------------------------
# Only needed on the deployment host, and only so a failed nightly sync +
# embed becomes a GitHub notification instead of silence. Without a token
# the seed still runs; it just cannot report, and the seed watchdog
# workflow will (correctly) start complaining that nothing is reporting.
#
# A fine-grained PAT scoped to this repo with Actions: read and write is
# enough - it only dispatches .github/workflows/nightly-seed.yml. Keep it
# separate from GITHUB_TOKEN above, which the app itself reads and which
# needs no write access at all.
# SEED_ALERT_TOKEN=
# Defaults to the owner/name of the `origin` remote, and to `main`.
# SEED_ALERT_REPO=owner/repo
# SEED_ALERT_REF=main
